# ==============================================================================
# 🎮 STREAMING OVERLAY 3.0 - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN DASHBOARD AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Password used to log in to the admin panel at /login (Default: admin)
ADMIN_PASSWORD=admin

# Random 64-char secret key for signing API session tokens (e.g. openssl rand -hex 32)
API_SECRET=your_random_secret_token_here
NEXT_PUBLIC_API_SECRET=your_random_secret_token_here

# ------------------------------------------------------------------------------
# 2. UPSTASH / VERCEL KV STORAGE (Required for cloud sync & SSE stream)
# ------------------------------------------------------------------------------
# Create a free Redis database at https://upstash.com or via Vercel KV Integration
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
KV_REST_API_READ_ONLY_TOKEN=your_upstash_readonly_token

# ------------------------------------------------------------------------------
# 3. GPS & LOCATION & WEATHER (Free API Keys)
# ------------------------------------------------------------------------------
# Real-Time GPS Tracking from https://rtirl.com (Pull Key from RTIRL App)
NEXT_PUBLIC_RTIRL_PULL_KEY=

# Reverse Geocoding for City/Neighbourhood Names (Free from https://locationiq.com)
NEXT_PUBLIC_LOCATIONIQ_KEY=

# Live Weather & Temperature (Free from https://openweathermap.org/api)
NEXT_PUBLIC_OPENWEATHERMAP_KEY=

# ------------------------------------------------------------------------------
# 4. BELABOX BITRATE & SRT STATS (Optional)
# ------------------------------------------------------------------------------
# Belabox Publisher Key from https://cloud.belabox.net (Can also be set in Dashboard)
NEXT_PUBLIC_BELABOX_KEY=

# ------------------------------------------------------------------------------
# 5. TWITCH INTEGRATION (Optional - for Sub Goals & Shoutout Avatars)
# ------------------------------------------------------------------------------
# Twitch Developer Application Client ID from https://dev.twitch.tv/console
NEXT_PUBLIC_TWITCH_CLIENT_ID=xjl7wqa2c3pyrb7u1d9wyzp6xlyyiw

# ------------------------------------------------------------------------------
# 6. PULSOID HEART RATE (Optional)
# ------------------------------------------------------------------------------
# Heart Rate Monitor Token from https://pulsoid.net
NEXT_PUBLIC_PULSOID_TOKEN=